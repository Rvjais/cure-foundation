# Cure Foundation India site
#
# Routing does NOT depend on this file. Every page is a real .php file in
# this directory, so /about-us.php is served directly by Apache/LiteSpeed:
#
#   /about-us.php                       -> about-us.php
#   /author__cureweb__page__2.php       -> author__cureweb__page__2.php
#
# This file only adds a friendly 404 page. The shared PHP library is blocked
# separately by includes/.htaccess.

DirectoryIndex index.php

ErrorDocument 404 /404.php
